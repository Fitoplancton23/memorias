# Copiar a .env y completar. .env NO se commitea.
# La key publicable es pública por diseño: va en el cliente y en el repo sin
# problema. La secreta (sb_secret_… / service_role) NO entra acá nunca: el
# build sólo lee, y lee lo que la RLS deja ver.
SUPABASE_URL=https://qjjornughrsuaxaecqty.supabase.co/rest/v1/
SUPABASE_KEY=

# --- el panel de carga ---------------------------------------------------
# El panel corre en el navegador, así que necesita las mismas dos cosas con el
# prefijo PUBLIC_ para que Astro se las pase al cliente. Es la MISMA key
# publicable de arriba: lo que decide qué se puede escribir es la RLS, no
# esconder la clave.
PUBLIC_SUPABASE_URL=https://qjjornughrsuaxaecqty.supabase.co
PUBLIC_SUPABASE_KEY=

# El deploy hook de Cloudflare Pages: la URL que dispara el build cuando el
# profe aprieta Publicar. Sin esto el botón no aparece y el sitio se actualiza
# igual con cada push.
PUBLIC_DEPLOY_HOOK=
