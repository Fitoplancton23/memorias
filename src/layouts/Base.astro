---
import '../styles/tokens.css';
/* `fuente` ya es el ayudante de los videos de intro en este archivo, así
   que el del snapshot entra con otro nombre. El choque no rompía el build:
   dejaba la función entera impresa dentro de la etiqueta. */
import { demo, sinAprobar, generado, fuente as fuenteDatos, totales } from '../lib/datos.js';
import { sitio, tituloSitio, parajes, estudio } from '../lib/sitio.js';
import Isotipo from '../components/Isotipo.astro';
import Ondas from '../components/Ondas.astro';
import Conecta from '../components/Conecta.astro';
import Fondo from '../components/Fondo.astro';
import Conmutador from '../components/Conmutador.astro';
import { existsSync } from 'node:fs';
/* La intro existe sólo si el archivo está. Se mira en el build y no en el
   navegador: así, sin video, el HTML ni siquiera menciona una etiqueta de
   video, y la portada es exactamente la que fue siempre. Para sacarla, se
   borran los archivos de public/intro/ y se vuelve a construir.

   Dos versiones, una por forma de pantalla. No es un lujo: un apaisado de
   1280 estirado para cubrir una pantalla de 390 de ancho tira casi todos sus
   píxeles afuera del cuadro, y encima pesa de más. La elige el navegador; el
   build sólo informa cuáles existen.

   El WebM es opcional en los dos casos. El MP4 solo alcanza y se reproduce en
   todos lados; el WebM está únicamente para pesar menos, así que si no está,
   se usa el MP4 y listo. */
const cual = n => ({
  mp4:  existsSync(`public/intro/${n}.mp4`),
  webm: existsSync(`public/intro/${n}.webm`),
  poster: existsSync(`public/intro/${n}.webp`),
});
const introWeb = cual('intro-web');
const introMob = cual('intro-mob');
const fuente = (n, v) => v.webm ? `/intro/${n}.webm` : v.mp4 ? `/intro/${n}.mp4` : '';
/* Sin versión de escritorio no hay intro: es la que cubre el caso general, y
   encender la intro sólo en teléfonos sería una sorpresa, no una decisión. */
const hayIntro = introWeb.mp4 || introWeb.webm;
const srcWeb = fuente('intro-web', introWeb);
const srcMob = fuente('intro-mob', introMob) || srcWeb;
const posterWeb = introWeb.poster ? '/intro/intro-web.webp' : '';
const posterMob = introMob.poster ? '/intro/intro-mob.webp' : posterWeb;

const { titulo, descripcion, suelto = false } = Astro.props;
/* En qué superficie estamos, para marcar el conmutador. El inicio no es una
   superficie de exploración: ahí se elige, y el conmutador no tiene sentido. */
const ruta = Astro.url.pathname;
const vista = ruta === '/mapa/' || ruta === '/mapa' ? 'mapa'
            : ruta === '/memorias/' || ruta === '/memorias' ? 'tiempo' : null;
/* A dónde lleva el botón de volver cuando no hay a dónde volver.
   -------------------------------------------------------------------------
   Antes decía "Volver al mapa" en todas las páginas que no son una de las dos
   vistas, y eso quedó de cuando el mapa era el centro del sitio. Hoy alguien
   puede llegar a una memoria desde la línea de tiempo, desde una persona o
   desde otra memoria, y mandarlo al mapa es mandarlo a cualquier lado.

   El botón vuelve de verdad —al paso anterior— cuando hay un paso anterior
   dentro del sitio. Cuando no lo hay, porque el enlace llegó por WhatsApp o
   por Google, no se puede "volver" a ningún lado: ahí lleva a la lista que
   contiene a esta página y lo dice con su nombre, en vez de prometer una
   vuelta que no existe. El rótulo lo cambia el guion recién cuando comprueba
   que hay historia, así que sin JavaScript el enlace sigue siendo honesto. */
const vuelta = ruta.startsWith('/lugares/')
  ? { href: '/mapa/', rotulo: 'Ver el mapa' }
  : { href: '/memorias/', rotulo: 'Todas las memorias' };

const t = titulo ? `${titulo} · ${tituloSitio}` : tituloSitio;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{t}</title>
  {descripcion && <meta name="description" content={descripcion} />}
  <link rel="icon" href="/icono.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#edf9f4" />
  {/* De dónde salieron los datos de este build y cuándo se armó.
      -------------------------------------------------------------------
      No es para quien visita: es para contestar en dos segundos la pregunta
      "publiqué una memoria y no aparece". Si acá dice `csv`, el deploy no
      leyó Supabase —se quedó sin credenciales y cayó a las planillas, que es
      algo que hace EN SILENCIO— y el sitio está mostrando datos viejos. Si
      dice `supabase` y la memoria igual no está, el problema es otro y hay
      que buscarlo en la base, no en el deploy.
      Se mira con "ver código fuente" en cualquier página. */}
  <meta name="memorias-build"
        content={`fuente=${fuenteDatos} generado=${generado} memorias=${totales?.documentos ?? 0}`} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@300;400;500;600&display=swap" />
  {/* Antes de pintar: si ya se vio la portada en esta visita, la pantalla de
      carga no existe. Así moverse por el sitio no pasa por ella cada vez. */}
  <script is:inline>
    /* Moverse por el sitio no pasa por la pantalla de carga; recargar sí. Sin
       esa excepción, una vez vista en la visita no hay manera de volver a
       verla, que es justo lo que hace falta mientras se la está ajustando. */
    try {
      var nav = performance.getEntriesByType('navigation')[0];
      var recarga = nav && nav.type === 'reload';
      if (!recarga && sessionStorage.getItem('memorias:visto')) document.documentElement.classList.add('sin-carga');
    } catch (e) {}
  </script>
</head>
<body>
  {/* El papel va primero y detrás de todo. En las pantallas de lienzo completo
      —el mapa, los linajes— se atenúa: ahí el dibujo es lo que hay que leer. */}
  <Fondo intensidad={suelto ? 'tenue' : 'normal'} />

  {/* `con-video` lo pone el BUILD, no el script. Si lo pusiera el script, entre
      que se pinta la página y que el video arranca se alcanza a ver el isotipo
      verde dibujándose, y lo que sigue es un corte a la pieza: tres cosas
      distintas en dos segundos. Naciendo en modo video, lo primero que se ve
      es el afiche de la pieza. Si después resulta que el video no corre, el
      script saca la clase y vuelve la portada de siempre, entera. */}
  <div class={`cargando${hayIntro ? ' con-video' : ''}`} id="cargando">
    {hayIntro && (
      <>
        {/* `preload="none"`: la intro no puede competir por ancho de banda con
            lo que hace falta para que el sitio exista. La carga la arranca el
            script, y si no llega a tiempo no hay intro. */}
        {/* Sin `src` ni `<source>`: lo pone el script según el ancho de la
            pantalla. `<source media>` adentro de un video no es confiable
            —anda en `<picture>` y en video los motores lo trataron distinto a
            lo largo de los años—, y acá el script ya maneja todo lo demás. */}
        <video class="cargando-video" id="introVideo" muted playsinline
               preload="none" aria-hidden="true" tabindex="-1"
               data-web={srcWeb} data-mob={srcMob}
               data-poster-web={posterWeb} data-poster-mob={posterMob}></video>
        {/* La salida, visible desde el primer segundo. Una intro de diez
            segundos sin forma de saltarla es una pared, y buena parte de quien
            entra acá viene de un enlace de WhatsApp a buscar una foto, no a
            mirar una presentación. Es un botón de verdad: se ve, se tabula y
            Escape hace lo mismo. */}
        <button type="button" class="cargando-saltar" id="saltarIntro" hidden>Saltar intro</button>
      </>
    )}
    <Isotipo clase="cargando-marca" dibujable />
    <span class="cargando-puntos" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="visualmente-oculto">Cargando {sitio.nombre}</span>
  </div>

  {demo && (
    <div class="cinta-demo">
      Datos de <strong>demostración</strong>: las personas y los parentescos son inventados.
      No son historia de {sitio.lugar}.
    </div>
  )}
  {sinAprobar > 0 && (
    <div class="cinta-pendiente">
      Vista local: incluye <strong>{sinAprobar}</strong> memoria(s) <strong>sin aprobar</strong>. No publicar.
    </div>
  )}
  <header class="sitio">
    <div class="envoltorio">
      <a class="marca" href="/">
        <Isotipo />
        <span class="marca-texto">
          <b>{sitio.nombre}</b>
          <em>{parajes}</em>
        </span>
      </a>
      {/* Dos vistas del mismo archivo —dónde ocurrió y cuándo— y un directorio.
          La dirección de la línea de tiempo sigue siendo /memorias/: los
          enlaces que alguien ya mandó por WhatsApp tienen que seguir
          funcionando, y cambiar la URL para que coincida con el rótulo del
          menú los rompería a todos. */}
      {/* Dos vistas y nada más. "Personas y familias" salió del menú: el
          directorio existe y las fichas se siguen alcanzando desde cualquier
          memoria —que es el recorrido que el archivo promete, de la foto a la
          persona— pero como puerta del sitio todavía no está lista. Vuelve
          cuando lo esté; no se borró nada. */}
      <nav>
        <a href="/mapa/">Mapa</a>
        <a href="/memorias/">Línea de tiempo</a>
      </nav>
    </div>
  </header>
  {vista && <Conmutador actual={vista} />}
  {!vista && ruta !== "/" && (
    <a class="volver-mapa" id="volver" href={vuelta.href}>
      <span aria-hidden="true">←</span>
      <b>{vuelta.rotulo}</b>
    </a>
  )}
  <main class={suelto ? "suelto" : "envoltorio"}><slot /></main>
  {!suelto && (
    <footer class="sitio">
      <Ondas clase="ondas-pie" />
      <div class="envoltorio">
        <p class="pie-archivo">
          Archivo comunitario de {sitio.lugar}, {sitio.provincia} · Material aportado por vecinas y vecinos.
        </p>

        {/* El crédito del estudio va separado del archivo y abajo: son dos
            cosas distintas y leerlas juntas las confunde. El archivo es del
            pueblo; el sitio lo hizo alguien. */}
        <div class="pie-credito">
          <Conecta clase="pie-logo" />
          <p>
            Creado por <b>{estudio.nombre}</b> — {estudio.autor}.<br />
            Contacto: <a href={`mailto:${estudio.correo}`}>{estudio.correo}</a>
          </p>
        </div>
      </div>
    </footer>
  )}

  {/* is:inline a propósito: sin esto Astro lo mete en el bundle de la página,
      que importa d3. La pantalla de carga no se podría ir hasta que bajaran
      57 KB de JavaScript, que es exactamente al revés de lo que tiene que
      pasar. Así son 400 bytes en el HTML y corre apenas se parsea. */}
  <script is:inline>
    /* El botón de volver, cuando hay a dónde.
       -------------------------------------------------------------------
       `history.back()` sólo es "volver a donde estabas" si el paso anterior
       es de este sitio. Si alguien abrió el enlace desde WhatsApp, el paso
       anterior es WhatsApp, y mandarlo ahí no es volver al archivo: es
       sacarlo del archivo. `document.referrer` lo distingue, y como la
       navegación dentro del sitio no es de una sola página, alcanza con
       mirarlo al cargar.

       Un `pushState` nuestro también cuenta: en el mapa, abrir una memoria
       empuja una entrada, y ahí volver tiene que cerrarla. */
    (() => {
      const b = document.getElementById('volver');
      if (!b) return;
      let propio = false;
      try { propio = !!document.referrer &&
        new URL(document.referrer).origin === location.origin; } catch (e) {}
      if (!propio || history.length <= 1) return;   /* el enlace queda como está */
      b.querySelector('b').textContent = 'Volver';
      b.addEventListener('click', ev => { ev.preventDefault(); history.back(); });
    })();
  </script>

  <script is:inline>
    /* La pantalla de carga no retrasa nada: se va en cuanto el sitio está, con
       un piso para que el trazo del logo se llegue a leer y un techo para que
       una conexión lenta no deje a nadie mirando un logo. Una sola vez por
       visita. */
    const capa = document.getElementById('cargando');
    if (capa && !document.documentElement.classList.contains('sin-carga')) {
      const esperar = ms => new Promise(r => setTimeout(r, ms));
      const listo = new Promise(r => {
        let hecho = false;
        const ok = () => { if (!hecho) { hecho = true; r(); } };
        addEventListener('mapa-listo', ok, { once: true });
        if (document.readyState === 'complete') ok();
        else addEventListener('load', ok, { once: true });
      });
      /* El piso cubre lo que dura la animación —1,5s de trazo más el relleno
         que termina en 1,75s— más un respiro. Con 1150 ms la pantalla se iba
         antes de que el isotipo terminara de dibujarse: entraba y salía sin
         que se llegara a ver. */
      const irse = () => {
        if (capa.classList.contains('se-va')) return;
        capa.classList.add('se-va');
        try { sessionStorage.setItem('memorias:visto', '1'); } catch (e) {}
        /* El aviso sale cuando la pantalla ya se fue, no cuando empieza a irse:
           si salen juntas, el isotipo y la capa se funden a la vez y en lugar
           de dos tiempos se percibe uno solo. */
        setTimeout(() => { capa.remove(); dispatchEvent(new Event("carga-se-va")); }, 750);
      };

      /* ---- la intro ----
         Diez segundos es una puerta larga, así que tiene tres salidas: el botón
         de saltar, Escape, y que el video no esté listo a tiempo. Ninguna de
         las tres depende de que el video llegue bien. */
      const video = document.getElementById('introVideo');
      const saltar = document.getElementById('saltarIntro');

      /* Cuándo NO hay intro. Las tres primeras son del visitante y no se
         discuten; la cuarta es de la conexión. */
      const sinIntro = !video
        || matchMedia('(prefers-reduced-motion: reduce)').matches
        || (navigator.connection && (navigator.connection.saveData
            || /^[23]g$/.test(navigator.connection.effectiveType || '')));

      if (sinIntro) {
        capa.classList.remove('con-video');
        Promise.race([Promise.all([esperar(2050), listo]), esperar(3400)]).then(irse);
      } else {
        const SALIDA = 600;        /* lo que tarda la cortina en abrirse */
        const PACIENCIA = 1200;    /* lo que se espera a que el video arranque */
        const CON_BOTON = 5000;    /* de acá para arriba, la intro lleva salida visible */

        /* Los tiempos salen del archivo, no de un número escrito a mano. La
           primera versión tenía el largo de la pieza clavado en el código y en
           el CSS: cambiarla de diez segundos a tres obligaba a tocar tres
           números en dos archivos y a que los tres cuadraran entre sí. Ahora
           se le pregunta al video cuánto dura y todo lo demás se despeja de
           ahí.

           La cuenta: el isotipo tiene que estar completo cuando empieza a
           abrirse la cortina, o sea `fin`. El relleno dura medio segundo y
           cierra ahí; el trazo termina dos décimas después de que el relleno
           arranca, como en la pantalla de carga de siempre; y el trazo dura lo
           que entre, entre un segundo y tres y medio. */
        const tiempos = dur => {
          const fin = Math.max(1200, dur * 1000 - SALIDA);
          const rellenoDel = fin - 500;
          const trazoFin = rellenoDel + 200;
          const trazo = Math.min(3500, Math.max(1000, trazoFin - 250));
          return { fin, trazo, trazoDel: Math.max(150, trazoFin - trazo),
                   relleno: 500, rellenoDel };
        };

        /* El presupuesto. Si en PACIENCIA el video no empezó a correr, no hay
           intro y la portada se comporta como siempre: nadie se queda mirando
           un rectángulo negro esperando algo que no va a llegar. */
        /* La forma de la pantalla elige la versión, con el mismo corte que usa
           el resto del sitio. Se decide una vez y no se vuelve a mirar: girar
           el teléfono a mitad de la intro no puede reiniciar el video. */
        const chica = matchMedia('(max-width: 46rem)').matches;
        const poster = video.dataset[chica ? 'posterMob' : 'posterWeb'];
        if (poster) video.poster = poster;
        video.src = video.dataset[chica ? 'mob' : 'web'];

        const arranco = new Promise(r => {
          video.addEventListener('playing', () => r(true), { once: true });
          video.addEventListener('error', () => r(false), { once: true });
          setTimeout(() => r(false), PACIENCIA);
          video.load();
          const p = video.play();
          if (p && p.catch) p.catch(() => r(false));
        });

        arranco.then(anda => {
          if (!anda) {
            capa.classList.remove('con-video');
            video.remove();
            if (saltar) saltar.remove();
            Promise.race([Promise.all([esperar(2050), listo]), esperar(3400)]).then(irse);
            return;
          }
          /* Recién ahora la portada pasa a modo intro: el isotipo se dibuja
             despacio y termina junto con el video, y el botón de saltar
             aparece. Antes de esto no se muestra, porque si el video no
             arranca no hay nada que saltar. */
          /* `video.duration` puede no estar —un archivo raro, un error de
             lectura—, y ahí se usan tres segundos, que es lo que dura la pieza
             hoy. Nunca se queda sin número. */
          const largo = Number.isFinite(video.duration) && video.duration > 0
            ? video.duration : 3;
          const t = tiempos(largo);
          capa.style.setProperty('--trazo-dur', t.trazo + 'ms');
          capa.style.setProperty('--trazo-del', t.trazoDel + 'ms');
          capa.style.setProperty('--relleno-dur', t.relleno + 'ms');
          capa.style.setProperty('--relleno-del', t.rellenoDel + 'ms');
          /* Reiniciar las animaciones del isotipo antes de cambiarles los
             tiempos. Venían corriendo desde que se pintó la página con los
             valores de la portada normal, y cambiarle la duración y el retraso
             a una animación que ya arrancó NO la vuelve a empezar: el
             navegador aplica los números nuevos contra el arranque viejo. El
             relleno cerraba 200 ms antes de tiempo —medido— y con una pieza de
             tres segundos eso es casi un diez por ciento de la puerta. Apagar,
             forzar el recálculo leyendo una medida, y volver a encender. */
          /* Que el mapa no se vele con las ondas cuando la portada se va: la
             entrega ya la hizo la pieza, y dos entregas seguidas —el video que
             se funde y después las ondas que se abren— se leen como que algo
             salió mal. */
          document.documentElement.classList.add('vino-con-intro');

          const marca = capa.querySelector('.cargando-marca');
          if (marca) { marca.style.animation = 'none'; void marca.offsetWidth; }
          capa.classList.add('con-intro');
          if (marca) marca.style.animation = '';

          /* La salida visible es para una puerta larga. En una de tres
             segundos el botón aparece y se va antes de que nadie lo registre:
             es ruido encima de la pieza, y lo que protegía —quedarse
             encerrado— ya no puede pasar, porque el reloj la cierra igual.
             Escape sigue andando siempre, que no le cuesta nada a nadie. */
          if (saltar) {
            if (largo * 1000 >= CON_BOTON) saltar.hidden = false;
            else saltar.remove();
          }

          const cerrar = () => { video.pause(); irse(); };
          saltar?.addEventListener('click', cerrar);
          addEventListener('keydown', e => { if (e.key === 'Escape') cerrar(); });
          /* El reloj manda, no el evento `ended`: si el video se traba a mitad
             de camino, `ended` no llega nunca y la puerta queda cerrada. */
          setTimeout(irse, t.fin);
        });
      }
    } else if (capa) {
      capa.remove();
    }
  </script>
</body>
</html>
