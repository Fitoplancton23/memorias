    .t-cab p { margin: .2rem 0 0; font-size: .78rem; color: var(--tinta-2); }
    .t-cerrar { margin-left: auto; flex: none; width: 30px; height: 30px; border-radius: 50%;
                border: .5px solid rgba(24, 30, 27, .12); background: rgba(255, 255, 255, .6);
                color: var(--tinta-2); font-size: 1.05rem; line-height: 1; cursor: pointer; }
    .t-cerrar:hover { color: var(--cursor); border-color: var(--cursor); }

    .t-fotos { display: grid; gap: 2px; padding: 0; margin: 0;
               grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
    .t-fotos img { width: 100%; height: auto; max-height: 62vh; object-fit: contain;
                   display: block; background: var(--panel-2); }
    .t-cuerpo { padding: 1rem 1.3rem 1.2rem; }
    .t-cuerpo p { margin: 0 0 .7rem; font-size: .86rem; line-height: 1.55; }
    .t-dato { font-size: .76rem; color: var(--tinta-2); margin: 0 0 .35rem; }
    .t-dato b { font-weight: 500; color: var(--tinta); }
    .t-cuenta { white-space: nowrap; }

    /* El recorrido del lugar en el tiempo. La tira de años no es decoración:
       dice de cuándo a cuándo llega el material de ese lugar y en qué parte
       estás, y lleva a cualquier año de un toque. */
    .t-pasos { display: flex; align-items: center; gap: .5rem;
               padding: .7rem 1rem; border-top: .5px solid rgba(24, 30, 27, .1); }
    .t-flecha { flex: none; width: 44px; height: 44px; border-radius: 50%; cursor: pointer;
                border: .5px solid rgba(255, 255, 255, .7);
