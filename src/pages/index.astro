---
import Base from '../layouts/Base.astro';
import Isotipo from '../components/Isotipo.astro';
import { documentos, lugares, personas } from '../lib/datos.js';
import { sitio, parajes } from '../lib/sitio.js';

/* La pantalla de inicio.
   -------------------------------------------------------------------------
   Antes acá estaba el mapa, y eso decidía por la gente: el mapa era el
   archivo y todo lo demás una salida del mapa. Son dos lecturas de lo mismo y
   ninguna es la principal, así que acá se elige, con las dos del mismo tamaño
   y el mismo peso.

   No es una portada de bienvenida con una frase linda: las dos opciones son lo
   único grande de la pantalla, y cada una dice qué pregunta contesta y cuánto
   material hay detrás. Un número real es mejor invitación que un adjetivo.

   El mapa se mudó a /mapa/. Ningún enlace profundo cambió —las memorias, los
   lugares y las personas conservan su dirección— y lo que alguien haya
   compartido de una memoria sigue abriendo esa memoria. */

const conFecha = documentos.map(d => d.fecha?.ref).filter(Boolean);
const rango = conFecha.length ? [Math.min(...conFecha), Math.max(...conFecha)] : null;
const ubicados = lugares.filter(l => l.lat != null && (l.documentos || []).length).length;
const sinFecha = documentos.length - conFecha.length;
---
<Base titulo={null}
      descripcion={`Archivo de memorias de ${parajes}. Recorrelo por el mapa o por la línea de tiempo.`}>
  <section class="inicio">
    <header class="inicio-cab">
      <Isotipo clase="inicio-marca" />
      <h1>{sitio.nombre}</h1>
      <p class="inicio-bajada">{parajes}</p>
      <p class="inicio-cuenta">
        {documentos.length} memorias
        {rango && <> entre {rango[0]} y {rango[1]}</>}
        {ubicados > 0 && <> · {ubicados} lugares</>}
        {personas.length > 0 && <> · {personas.length} personas</>}
      </p>
    </header>

    {/* Las dos puertas. Mismo tamaño, mismo tratamiento, mismo orden de
        lectura: la única diferencia es la pregunta que contesta cada una. */}
    <div class="puertas">
      <a class="puerta" href="/mapa/">
        <span class="puerta-dibujo" aria-hidden="true">
          <svg viewBox="0 0 120 92" fill="none" stroke="currentColor" stroke-width="1.6"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 22 42 10l36 14 34-12v58L78 82 42 68 8 80V22Z" opacity=".5" />
            <path d="M42 10v58M78 24v58" opacity=".5" />
            <circle cx="46" cy="38" r="6.5" /><path d="M46 44.5v9" />
            <circle cx="86" cy="52" r="5" /><path d="M86 57v7" />
          </svg>
        </span>
        <b>Mapa de memorias</b>
        <span class="puerta-pregunta">¿Dónde ocurrió?</span>
        <span class="puerta-detalle">Los lugares del pueblo, y lo que pasó en cada uno.</span>
      </a>

      <a class="puerta" href="/memorias/">
        <span class="puerta-dibujo" aria-hidden="true">
          <svg viewBox="0 0 120 92" fill="none" stroke="currentColor" stroke-width="1.6"
               stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 46h96" opacity=".5" />
            <circle cx="30" cy="46" r="6.5" /><path d="M30 39.5V22h26" />
            <circle cx="60" cy="46" r="5" /><path d="M60 51v16h24" />
            <circle cx="90" cy="46" r="6.5" /><path d="M90 39.5V26h18" />
          </svg>
        </span>
        <b>Línea de tiempo</b>
        <span class="puerta-pregunta">¿Cuándo? ¿Qué pasó?</span>
        <span class="puerta-detalle">El pueblo en orden, de lo más viejo a lo más nuevo.</span>
      </a>
    </div>

    <p class="inicio-pie">
      Las dos muestran el mismo archivo. Se puede cambiar de una a la otra en
      cualquier momento, sin volver acá.
      {sinFecha > 0 && <> Las {sinFecha} memorias sin fecha están igual: lo que falta se dice, no se esconde.</>}
    </p>
  </section>
</Base>

<style>
  /* La entrada: cada cosa llega un momento después de la anterior, de arriba
     hacia abajo, como se lee. No es decoración — es lo que convierte una
     pantalla que aparece de golpe en una que se presenta. Se apaga entera con
     `prefers-reduced-motion`. */
  .inicio { max-width: 52rem; margin: 0 auto; padding: 2rem 0 5rem;
            display: grid; gap: 2.6rem; }
  .inicio-cab { text-align: center; display: grid; justify-items: center; gap: .35rem; }
  .inicio-cab :global(.inicio-marca) { width: 4.6rem; height: 4.6rem;
                                       color: var(--marca); margin-bottom: .6rem; }
  .inicio-cab h1 { margin: 0; font-size: clamp(1.9rem, 5vw, 2.6rem); font-weight: 500; }
  .inicio-bajada { margin: 0; font-size: .82rem; letter-spacing: .1em;
                   text-transform: uppercase; color: var(--tinta-2); }
  .inicio-cuenta { margin: .5rem 0 0; font-size: .9rem; color: var(--tinta-2); }

  .puertas { display: grid; gap: 1.1rem; grid-template-columns: repeat(2, 1fr); }
  /* `1fr` las dos y el mismo contenido mínimo: ninguna puede quedar más grande
     que la otra por tener un texto más largo. La jerarquía pareja es el pedido
     y tiene que sostenerla la grilla, no el cuidado al escribir. */
  .puerta { display: grid; justify-items: start; gap: .3rem; border: 0;
            padding: 1.8rem 1.6rem 1.6rem; border-radius: .9rem;
            background: var(--panel); border: 1px solid var(--linea);
            color: var(--tinta); text-decoration: none;
            transition: border-color .2s ease, transform .2s ease, box-shadow .2s ease; }
  .puerta:hover { border-color: var(--linea-viva); transform: translateY(-3px);
                  box-shadow: 0 18px 38px -22px rgba(24,30,27,.55); }
  .puerta:focus-visible { outline: 2px solid var(--cursor); outline-offset: 3px; }
  .puerta-dibujo { display: block; width: 100%; margin-bottom: .9rem; color: var(--marca); }
  .puerta-dibujo svg { width: 100%; height: auto; max-height: 5.2rem; }
  .puerta b { font-size: 1.15rem; font-weight: 500; }
  /* En tinta y no en terracota: el terracota del sistema significa
     interacción —foco, hover, selección— y acá no hay nada que interactuar,
     es el rótulo de la puerta. La jerarquía la da el tamaño. */
  .puerta-pregunta { font-size: .98rem; color: var(--tinta); }
  .puerta-detalle { font-size: .84rem; color: var(--tinta-2); line-height: 1.5; }

  .inicio-pie { margin: 0; text-align: center; font-size: .84rem;
                color: var(--tinta-2); line-height: 1.6; max-width: 34rem;
                margin-inline: auto; }

  @media (max-width: 40rem) {
    .puertas { grid-template-columns: 1fr; }
    .puerta { padding: 1.4rem 1.2rem 1.2rem; }
  }

  .inicio-cab, .puerta, .inicio-pie { animation: llega .55s cubic-bezier(.22,.7,.3,1) backwards; }
  .inicio-cab { animation-delay: .05s; }
  .puerta:nth-of-type(1) { animation-delay: .22s; }
  .puerta:nth-of-type(2) { animation-delay: .32s; }
  .inicio-pie { animation-delay: .46s; }
  @keyframes llega { from { opacity: 0; transform: translateY(14px); } }

  @media (prefers-reduced-motion: reduce) {
    .inicio-cab, .puerta, .inicio-pie { animation: none; }
    .puerta:hover { transform: none; }
  }
</style>
