                backdrop-filter: blur(10px) saturate(1.5);
                box-shadow: 0 2px 12px -2px rgba(24, 30, 27, .5);
                font-size: 1.5rem; line-height: 1; color: var(--tinta);
                font-family: var(--texto); }
    .t-flecha:hover:not(:disabled) { background: #fff; color: var(--cursor); }
    .t-flecha:disabled { opacity: .35; cursor: default; }

    /* Sobre la foto: a media altura y pegadas al borde, siempre visibles.
       El vidrio y la sombra las sostienen lo mismo sobre una foto clara que
       sobre una oscura, que es lo que un simple círculo blanco no hace. */
    .t-fotos { position: relative; touch-action: pan-y; }
    .t-foto { transition: opacity .18s ease; }
    .t-foto.cambiando { opacity: .3; }

    /* Los puntos van sobre la imagen, al pie y centrados: dicen cuántas fotos
       hay y en cuál estás sin ocupar una fila propia ni pedir una etiqueta. */
    .t-puntos { position: absolute; left: 50%; bottom: 12px; transform: translateX(-50%);
                display: flex; gap: 7px; align-items: center; z-index: 2;
                padding: 7px 10px; border-radius: 999px;
                background: rgba(24, 30, 27, .3);
                -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
    .t-puntos button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%;
                       background: rgba(255, 255, 255, .5); cursor: pointer;
                       transition: background .18s ease, transform .18s ease; }
    .t-puntos button:hover { background: rgba(255, 255, 255, .8); }
    .t-puntos .actual { background: #fff; transform: scale(1.25); }
    .t-fotos .t-flecha { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; }
    .t-fotos .t-ant { left: 12px; }
    .t-fotos .t-sig { right: 12px; }

    .t-anios { flex: 1; display: flex; gap: .3rem; list-style: none; margin: 0; padding: 0;
               overflow-x: auto; scrollbar-width: none; }
    .t-anios::-webkit-scrollbar { display: none; }
    .t-anios button { flex: none; border: 0; background: none; cursor: pointer;
                      font: 400 .76rem var(--texto); color: var(--tinta-2);
                      padding: .3rem .55rem; border-radius: 999px; }
    .t-anios button:hover { color: var(--cursor); }
    .t-anios .actual { background: var(--tinta); color: var(--placa); font-weight: 500; }

    /* Al pasar de una memoria a otra el contenido entra por el lado al que
       fuiste: dice que te moviste en una dirección, no que cambió la pantalla. */
    .t-vista { animation: pasa-quieto .01s both; }
    .t-vista.viene-der { animation: pasa-der .26s cubic-bezier(.22, 1, .36, 1) both; }
    .t-vista.viene-izq { animation: pasa-izq .26s cubic-bezier(.22, 1, .36, 1) both; }
    @keyframes pasa-quieto { from { opacity: 1 } to { opacity: 1 } }
    @keyframes pasa-der { from { opacity: 0; transform: translateX(22px) } to { opacity: 1; transform: none } }
    @keyframes pasa-izq { from { opacity: 0; transform: translateX(-22px) } to { opacity: 1; transform: none } }

    .t-pie { display: flex; flex-wrap: wrap; gap: .5rem; padding: 0 1.3rem 1.2rem; }
    .t-pie a { font-size: .78rem; border: .5px solid rgba(24, 30, 27, .14); border-radius: 999px;
               padding: .32rem .8rem; background: rgba(255, 255, 255, .55); }
    .t-pie a:hover { border-color: var(--cursor); color: var(--cursor); }

    @media (max-width: 34rem) {
      .velo { padding: 0; place-items: end stretch; }
      .tarjeta { width: 100%; max-height: 88%; border-radius: 18px 18px 0 0; }
    }

    @media (max-width: 34rem) {
      .mapa-ficha { left: .7rem !important; top: auto !important;
                    right: .7rem; bottom: .7rem; width: auto; max-height: 55%; }
      .mapa-lienzo.con-ficha .mapa-ctrl { bottom: calc(55% + 1.4rem); }
    }

    .portada-texto { padding-top: 4.5rem; position: relative; }
    /* Invertidas: nacen del borde del mapa y bajan hacia el texto, como el
       terreno que sigue más allá del encuadre. */
    .ondas-portada { top: 0; bottom: auto; height: 9.5rem; transform: scaleY(-1); opacity: .26; }
    .portada-texto h1 { max-width: 20ch; }
    .puertas { display: grid; gap: 1px; background: var(--linea); border: 1px solid var(--linea);
               grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); margin: 2.5rem 0 3rem; }
    .puertas a { background: var(--panel); padding: 1.1rem 1.2rem; border: 0; display: block; }
    .puertas a:hover { background: var(--panel-2); }
    .puertas b { display: block; font-weight: 500; font-size: 1rem; margin-bottom: .2rem; }
    .puertas span { font-size: .78rem; color: var(--tinta-2); }
    .apellidos { display: flex; flex-wrap: wrap; gap: .4rem; }
    .apellidos a { border: 1px solid var(--linea); border-radius: 14px; padding: .22rem .7rem;
                   font-size: .8rem; }
    .apellidos a:hover { border-color: var(--cursor); }
    .apellidos i { font-style: normal; font-size: .7rem; color: var(--tinta-2); }

    @media (max-width: 880px) {
      .mapa-ficha { left: 1rem; right: 1rem; top: auto; bottom: 1rem; width: auto; max-height: 45%; }
      .marca-mapa { left: 1rem; }
      .cifras-mapa { left: 1rem; }
      /* En pantalla angosta el centro de abajo lo ocupa el crédito: la pieza
         sube para no encimarse. */
      .sin-ubicar { bottom: 3.1rem; font-size: .74rem; }
      .credito { left: 1rem; }
    }
