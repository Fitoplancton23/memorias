    }

    .t-cab { display: flex; gap: 1rem; align-items: flex-start;
             padding: 1.1rem 1.3rem .9rem; border-bottom: .5px solid rgba(24, 30, 27, .1); }
    .t-cab h2 { margin: 0; font-size: 1.1rem; font-weight: 500; line-height: 1.25;
