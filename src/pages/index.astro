    .sitio .retrato image { opacity: .97; }
    .sitio:hover .retrato .aro, .sitio:focus-visible .retrato .aro { stroke-width: 3.5; }
    .sitio.foco .retrato .aro { stroke: var(--cursor); stroke-width: 3.5; }

