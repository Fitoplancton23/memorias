---
import Base from '../layouts/Base.astro';
import { lugares, documentos, personas as personasTodas } from '../lib/datos.js';
import { aNormalizado } from '../lib/proyeccion.js';
import mapas from '../../public/mapa/mapa.json';
import Ondas from '../components/Ondas.astro';

/* El ejido, no el casco: de los once lugares relevados, tres caen fuera del
   casco urbano —los dos kilómetros de la ruta y Salto Encantado—. El archivo
   abarca las dos escalas porque el pueblo se fundó con los colonos de esos
   parajes, así que el mapa tiene que abarcarlas también. */
const mapa = mapas.mapas.find(m => m.nombre === 'ejido');
const [ANCHO, ALTO] = mapa.viewBox;

const doc = Object.fromEntries(documentos.map(d => [d.slug, d]));

/* La tarjeta de memoria se abre sobre el mapa, así que lo que muestra tiene que
   viajar con el punto: si tuviera que ir a buscarlo, abrir una memoria sería
   una espera, y la gracia de no salir del mapa es que no haya espera. */
const nombreDe = s => {
  const p = personasTodas.find(x => x.slug === s);
  if (!p) return null;
  return [p.nombre, p.apellido].filter(Boolean).join(' ') || p.apodo || null;
};
/* Cuántos metros mide una unidad del dibujo. Es lo que después deja saber a
   cuántos metros por píxel se está mirando, que es lo que decide si mostrar los
   puntos de una memoria tiene sentido o si todos caerían encima del lugar. */
const M_POR_UNIDAD = (() => {
  const [minlat, minlon, maxlat, maxlon] = mapa.bounds;
  const anchoM = (maxlon - minlon) * 111320 * Math.cos(((minlat + maxlat) / 2) * Math.PI / 180);
  return anchoM / ANCHO;
})();

/* Un lugar sin memorias no es un lugar del archivo todavía: es una ficha que
   alguien creó para ubicar algo que después no llegó. En el mapa sería un
   marcador que no lleva a ningún lado, y el archivo prometería material que
   no tiene. Cuando le entre la primera memoria, aparece solo. */
const puntos = lugares
  .filter(l => l.lat != null && l.lng != null)
  .filter(l => (l.documentos || []).length > 0)
  .map(l => {
    const { x, y } = aNormalizado(l.lat, l.lng, mapa);
    const docs = (l.documentos || []).map(s => doc[s]).filter(Boolean)
      .sort((a, b) => (a.fecha?.ref ?? 9999) - (b.fecha?.ref ?? 9999));
    const anios = docs.map(d => d.fecha?.ref).filter(Boolean);
    return {
      slug: l.slug, nombre: l.nombre, notas: l.notas || '',
      cx: +(x * ANCHO).toFixed(1), cy: +(y * ALTO).toFixed(1),
      fuera: x < 0 || x > 1 || y < 0 || y > 1,
      n: docs.length,
      foto: docs.find(d => d.archivo)?.archivo || null,
      desde: anios.length ? Math.min(...anios) : null,
      hasta: anios.length ? Math.max(...anios) : null,
      docs: docs.map(d => ({
        slug: d.slug, titulo: d.titulo,
        anio: d.fecha?.ref ?? null, texto: d.fecha?.texto || '',
        foto: d.archivo || null,
        /* Una memoria puede traer varias fotos del mismo momento. La portada
           abre, pero las otras tienen que poder verse sin salir de la tarjeta. */
        fotos: (d.archivos && d.archivos.length)
          ? d.archivos
          : (d.archivo ? [d.archivo] : []),
        descripcion: d.descripcion || '',
        gente: (d.personas || []).map(nombreDe).filter(Boolean),
        lugar: l.nombre,
        /* Regla 4: el punto propio de la memoria, ya proyectado al dibujo. Se
           calcula acá, en el build, y no en el navegador: es una cuenta por
           memoria que no cambia nunca. */
        punto: d.punto ? (() => {
          const q = aNormalizado(d.punto.lat, d.punto.lng, mapa);
          return { cx: +(q.x * ANCHO).toFixed(1), cy: +(q.y * ALTO).toFixed(1),
                   precision: d.punto.precision };
        })() : null,
      })),
    };
  })
  /* La raíz de la cantidad, no la cantidad: así lo que crece proporcional es el
     área, que es lo que el ojo compara. El marcador con foto arranca más grande
     porque tiene que leerse como imagen, no como punto de color.
     Los dos radios viajan juntos porque el marcador se repliega a punto cuando
     no hay lugar para la foto, y ahí el halo también tiene que achicarse. */
  .map(p => {
    const rPunto = 4 + Math.sqrt(p.n) * 2.6;
    const r = p.foto ? 15 + Math.sqrt(p.n) * 3 : rPunto;
    /* Los marcadores son HTML sobre el mapa, no SVG: backdrop-filter no pinta
       nada sobre un elemento SVG —se computa y no hace efecto— y sin él no hay
       vidrio. Como HTML, además, dejan de necesitar contraescala y recortes.
       Van en píxeles porque eso es lo que son: tamaño de pantalla, no de mapa. */
    const d = Math.round(r * 2 + 14);
    return { ...p, r, rPunto, d, dPunto: Math.max(Math.round(rPunto * 2 + 12), 18) };
  });

const conMaterial = puntos.length;
const totalDocs = puntos.reduce((a, p) => a + p.n, 0);
const anios = puntos.flatMap(p => p.docs.map(d => d.anio)).filter(Boolean);
const rango = anios.length ? [Math.min(...anios), Math.max(...anios)] : null;
const fuera = puntos.filter(p => p.fuera).length;
/* Las memorias sin ubicación no desaparecen del mapa: el mapa dice cuántas
   son y abre la puerta a verlas. Una memoria sin coordenada sigue siendo una
   memoria. */
const sinUbicar = documentos.filter(d => !(d.lugares || []).some(s => lugares.find(l => l.slug === s && l.lat != null))).length;

/* Debajo del mapa va texto de verdad. El lienzo no se indexa, y el canal por
   el que llega la gente a este archivo es buscar el apellido del abuelo en
   Google: la portada tiene que tener algo que Google pueda leer. */
const ultimas = [...documentos]
  .sort((a, b) => (b.fecha?.ref ?? -1) - (a.fecha?.ref ?? -1)).slice(0, 10);
const cuentaApellidos = {};
for (const d of documentos)
  for (const s of d.personas || []) {
    const p = personasTodas.find(x => x.slug === s);
    if (p?.apellido) cuentaApellidos[p.apellido] = (cuentaApellidos[p.apellido] || 0) + 1;
  }
const apellidosPortada = Object.entries(cuentaApellidos)
  .map(([a, n]) => ({ a, n })).sort((x, y) => y.n - x.n || x.a.localeCompare(y.a));
---
<Base descripcion="Archivo histórico de Aristóbulo del Valle, Salto Encantado y Cerro Moreno: memorias, personas, familias y lugares.">
  <div class="mapa-lienzo">
    <svg id="mapa" viewBox={`0 0 ${ANCHO} ${ALTO}`} role="application"
         aria-label="Mapa de Aristóbulo del Valle con las memorias ubicadas.">
      <g id="mundo">
        <g id="base"></g>
      </g>
    </svg>

    {/* Los marcadores viven acá, en HTML, por encima del dibujo. El JS les
        pone la posición en píxeles a partir de la transformación del zoom.
        Arrancan invisibles porque hasta esa primera pasada no saben dónde van. */}
    <div class="capa-marcas" id="marcas">
      {/* Los puntos de las memorias del lugar abierto. Regla 4: existen dentro
          del lugar, al entrar y al acercarse, y nunca con el mismo lenguaje
          visual que un lugar. */}
      <div class="puntos-memoria" id="puntosMemoria" aria-hidden="true"></div>

      {/* Las líneas que unen un marcador corrido con su punto verdadero.
          Van debajo de los marcadores y no reciben el mouse. */}
      <svg class="guias" id="guias" aria-hidden="true"></svg>

      {puntos.map(p => (
        <button type="button" class="marca-mapa"
                data-slug={p.slug} style={`--d:${p.d}px`}
                aria-label={`${p.nombre}, ${p.n} ${p.n === 1 ? 'memoria' : 'memorias'}`}>
          <span class="lente">
            {p.foto && <img class="retrato" src={p.foto} alt="" loading="lazy" decoding="async" />}
            <span class="grano"></span>
          </span>
          {!p.foto && <span class="rotulo">{p.nombre}</span>}
        </button>
      ))}
    </div>

    <div class="cifras-mapa vidrio">
      <b>{conMaterial}</b> lugares con memorias · <b>{totalDocs}</b> memorias
      {rango && <span> · {rango[0]}–{rango[1]}</span>}
    </div>

    {/* No es un dato más del encabezado: es una puerta a un montón de memorias
        que el mapa no puede mostrar. Va aparte y abajo, donde no compite con
        el recuento pero tampoco se pierde. */}
    {sinUbicar > 0 && (
      <a class="sin-ubicar vidrio" href="/memorias/?lugar=sin">
        <b>{sinUbicar}</b> memorias sin ubicación conocida
      </a>
    )}

    <aside class="mapa-ficha vidrio" id="ficha" hidden></aside>

    <div class="mapa-ctrl">
      <button id="acercar" class="vidrio" aria-label="Acercar">+</button>
      <button id="alejar" class="vidrio" aria-label="Alejar">−</button>
      <button id="todo" class="vidrio" aria-label="Ver todo">⌖</button>
    </div>

    {/* La memoria se abre encima del mapa, no en otra página: el mapa es el
        lugar desde donde se mira, y perderlo es perder el hilo de la visita.
        El enlace de abajo sigue siendo real —funciona sin JS y Google lo
        sigue—, el JS sólo lo intercepta. */}
    <div class="velo" id="velo" hidden>
      <article class="tarjeta vidrio" id="tarjeta" role="dialog" aria-modal="true" aria-labelledby="t-titulo"></article>
    </div>

    {/* Bajar al texto es una decisión, no un accidente del dedo: el scroll
        sobre el mapa mueve el mapa, y para ir abajo está esto. */}
    <button type="button" class="bajar vidrio" id="bajar" aria-label="Bajar al resto del archivo">
      <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none"
           stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9" />
      </svg>
    </button>

    {/* La transición del mapa. No es el mapa animándose: es una capa aparte
        por encima, que se disuelve. Debajo el mapa ya está entero y es
        interactivo —pointer-events: none hace que eso sea literal desde el
        primer instante—, y al terminar esta capa desaparece del documento. */}
    <div class="transicion" id="transicion" aria-hidden="true">
      <Ondas clase="ondas-transicion" />
    </div>

    <p class="credito">Base cartográfica © colaboradores de <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>, ODbL</p>
  </div>


  <section class="envoltorio portada-texto">
    <Ondas clase="ondas-portada" deriva />
    <h1>Aristóbulo es una historia que se cuenta todo el tiempo</h1>
    <p class="bajada">
      Un archivo hecho con las fotografías y los relatos de los vecinos de
      Aristóbulo del Valle, Salto Encantado y Cerro Moreno. Cada memoria se
      puede encontrar por el lugar donde ocurrió, por quiénes aparecen, o
      buscándola directamente.
    </p>

    <div class="puertas">
      <a href="/"><b>Mapa</b><span>¿Dónde ocurrió?</span></a>
      <a href="/memorias/"><b>Memorias</b><span>¿Qué ocurrió?</span></a>
      <a href="/personas/"><b>Personas y familias</b><span>¿Quiénes están relacionados?</span></a>
    </div>

    <h2>Últimas memorias</h2>
    <ul class="listado">
      {ultimas.map(m => (
        <li><a href={`/memorias/${m.slug}/`}>{m.titulo}</a>
          <span class="anio">{m.fecha?.ref ?? 'sin fecha'}</span></li>
      ))}
    </ul>

    {apellidosPortada.length > 0 && (
      <>
        <h2>Las familias del archivo</h2>
        <p class="apellidos">
          {apellidosPortada.map(a => (
            <a href={`/memorias/?apellido=${encodeURIComponent(a.a)}`}>{a.a} <i>{a.n}</i></a>
          ))}
        </p>
      </>
    )}
  </section>

  <script define:vars={{ PUNTOS: puntos, ANCHO, ALTO, M_POR_UNIDAD }}>
    window.__MAPA = { PUNTOS, ANCHO, ALTO, M_POR_UNIDAD };
  </script>

  <script>
    import { select } from 'd3-selection';
    import { zoom, zoomIdentity } from 'd3-zoom';
    import { separar, AIRE, GUIA_DESDE } from '../lib/separar.js';
    import { dobleToque } from '../lib/doble-toque.js';

    const { PUNTOS, ANCHO, ALTO, M_POR_UNIDAD } = window.__MAPA;
    const svgEl = document.getElementById('mapa');
    const mundo = document.getElementById('mundo');
    const base = document.getElementById('base');
    const capa = document.getElementById('marcas');
    const ficha = document.getElementById('ficha');
    const velo = document.getElementById('velo');
    const tarjeta = document.getElementById('tarjeta');
    const lienzo = document.querySelector('.mapa-lienzo');

    const porSlug = Object.fromEntries(PUNTOS.map(p => [p.slug, p]));
    const porMemoria = {};
    for (const p of PUNTOS) for (const d of p.docs) porMemoria[d.slug] = { ...d, lugarSlug: p.slug };

    /* Los nombres y relatos los escribe quien administra, no un desconocido,
       pero un apellido con & o un título con comillas rompen el HTML igual. */
    const esc = t => String(t == null ? '' : t)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');

    /* La base se trae aparte en vez de incrustarse: son 800 KB de trazados que
       el navegador cachea una vez y no tienen por qué viajar dentro del HTML
       en cada visita. */
    fetch('/mapa/ejido.svg')
      .then(r => r.text())
      .then(t => {
        const doc = new DOMParser().parseFromString(t, 'image/svg+xml');
        const svg = doc.documentElement;
        for (const hijo of Array.from(svg.childNodes))
          if (hijo.nodeType === 1 && hijo.nodeName !== 'metadata') base.appendChild(hijo);
        base.classList.add('listo');
        capa.classList.add('listo');
        dispatchEvent(new Event('mapa-listo'));
      })
      .catch(() => {
        /* Sin base no hay mapa, pero los marcadores tienen que aparecer igual. */
        base.innerHTML = '';
        capa.classList.add('listo');
        dispatchEvent(new Event('mapa-listo'));
      });

    /* ---- marcadores ---- */
    const marcas = [...capa.querySelectorAll('.marca-mapa')].map(el => ({
      el, rotulo: el.querySelector('.rotulo'), p: porSlug[el.dataset.slug],
    })).filter(m => m.p).sort((a, b) => b.p.n - a.p.n);
    marcas.forEach((m, i) => m.el.style.setProperty('--orden', i));

    /* Cada lugar tiene su propio zoom a partir del cual muestra la foto, y ese
       número sale de cuán apretado está: la distancia al vecino más cercano.
       Antes la forma la decidía una colisión calculada en cada cuadro, y por eso
       no se sentía ninguna regla —dos marcadores al mismo zoom podían estar en
       estados distintos sin nada visible que lo explicara—. Ahora es una sola
       regla y se lee: al acercarse, las fotos van apareciendo de la más aislada
       a la más apretada, siempre en el mismo orden y siempre en el mismo punto. */
    function umbrales() {
      for (const m of marcas) {
        if (!m.p.foto) { m.p.kFoto = Infinity; continue; }
        let cerca = Infinity;
        for (const o of marcas) {
          if (o === m) continue;
          const d = Math.hypot(o.p.cx - m.p.cx, o.p.cy - m.p.cy);
          if (d < cerca) cerca = d;
        }
        if (!isFinite(cerca)) { m.p.kFoto = 0; continue; }
        /* Lo que la foto necesita en pantalla: su radio, el del vecino y aire. */
        const necesita = m.p.d / 2 + 22;
        m.p.kFoto = Math.max(0, necesita / (cerca * razon));
      }
    }

    /* El mapa es el tronco de la navegación: se vuelve a él donde se lo dejó,
       no al encuadre inicial. Se guarda en sessionStorage —dura lo que dura la
       visita, no se queda pegado para siempre— y lo lee la vuelta desde
       cualquier página del sitio. */
    const CLAVE = 'mapa-donde-estaba';
    let tActual = zoomIdentity;
    function guardarEstado() {
      try {
        sessionStorage.setItem(CLAVE, JSON.stringify({
          k: tActual.k, x: tActual.x, y: tActual.y, abierta,
        }));
      } catch (e) { /* modo privado o storage lleno: se pierde el lugar, nada más */ }
    }
    function estadoGuardado() {
      try { return JSON.parse(sessionStorage.getItem(CLAVE) || 'null'); }
      catch (e) { return null; }
    }

    /* El SVG no llena el contenedor: con preserveAspectRatio por defecto el
       viewBox entra completo y queda bordeado. Los marcadores son HTML sobre el
       contenedor, así que hay que sumar ese borde o quedan corridos. */
    let razon = 1, offX = 0, offY = 0, padX = 0, padY = 0, kActual = 1;
    function medir() {
      const c = svgEl.getBoundingClientRect(), l = lienzo.getBoundingClientRect();
      razon = Math.min(c.width / ANCHO, c.height / ALTO) || 1;
      /* Las bandas vacías que deja preserveAspectRatio al centrar el viewBox.
         Importan dos veces: para colocar los marcadores y para decirle a d3
         dónde empieza de verdad lo que se ve. */
      padX = (c.width - ANCHO * razon) / 2;
      padY = (c.height - ALTO * razon) / 2;
      offX = (c.left - l.left) + padX;
      offY = (c.top - l.top) + padY;
    }
    function medirTodo() {
      medir();
      limitar();
      umbrales();
      const r = lienzo.getBoundingClientRect();
      const arriba = Math.max(0, r.top + window.scrollY);
      document.documentElement.style.setProperty('--alto-hero',
        Math.max(320, window.innerHeight - arriba) + 'px');
    }

    /* Una sola pasada coloca cada marcador, decide su forma y si entra su
       nombre. Va en orden de cantidad de memorias: el lugar con más material es
       el que se queda con la foto cuando dos se pisan.

       El marcador nunca desaparece —un lugar que se borra del mapa es un lugar
       que el archivo dejó de tener—, pero sí se repliega. Lo decide el espacio
       real que hay, no un umbral de zoom: así un paraje aislado conserva su
       foto de lejos y el casco se va abriendo al acercarse. */
    /* Los puntos de las memorias del lugar abierto.
       --------------------------------------------------------------------
       Aparecen con dos condiciones y las dos importan. Que el lugar esté
       abierto: son detalle de adentro, no información del mapa general. Y que
       la escala sea fina: a quince metros por píxel, el patio y el salón de
       actos caen sobre el mismo píxel y dibujarlos sería mentir sobre lo que
       se está viendo.

       El umbral es 1,5 metros por píxel. A esa escala, dos memorias separadas
       por quince metros —el ancho de un patio— quedan a diez píxeles: se ven
       como dos cosas distintas. Más lejos que eso se amontonarían encima del
       marcador del lugar y no agregarían nada.

       La incertidumbre se dibuja, no se esconde: un punto exacto es un disco
       chico y nítido, uno aproximado es un halo punteado y más grande. Es el
       mismo lenguaje que ya usa la línea de tiempo, donde la duda se codifica
       como extensión. */
    const UMBRAL_PUNTOS = 1.5;   /* metros por píxel */
    let focoVisible = null;

    function dibujarPuntos(t) {
      const caja = document.getElementById('puntosMemoria');
      if (!caja) return;
      const p = abierta ? porSlug[abierta] : null;
      const mPorPx = M_POR_UNIDAD / (razon * t.k);
      const conPunto = p ? p.docs.filter(d => d.punto) : [];

      if (!p || !conPunto.length || mPorPx > UMBRAL_PUNTOS) {
        if (caja.childElementCount) caja.replaceChildren();
        caja.dataset.lugar = '';
        lienzo.classList.remove('con-puntos');
        return;
      }

      /* Se rearma sólo si cambió el lugar; en cada movimiento basta mover. */
      if (caja.dataset.lugar !== p.slug) {
        caja.dataset.lugar = p.slug;
        caja.replaceChildren(...conPunto.map(d => {
          const el = document.createElement('a');
          el.className = 'punto-memoria' +
            (d.punto.precision === 'aproximada' ? ' aproximado' : '');
          el.href = '/memorias/' + encodeURIComponent(d.slug) + '/';
          el.dataset.mem = d.slug;
          el.title = d.titulo + (d.punto.precision === 'aproximada'
            ? ' · ubicación aproximada' : '');
          const n = document.createElement('span');
          n.className = 'punto-nombre';
          n.textContent = d.titulo;
          el.append(n);
          return el;
        }));
      }

      lienzo.classList.add('con-puntos');
      [...caja.children].forEach((el, i) => {
        const d = conPunto[i];
        const x = offX + (d.punto.cx * t.k + t.x) * razon;
        const y = offY + (d.punto.cy * t.k + t.y) * razon;
        el.style.transform = 'translate(' + x + 'px,' + y + 'px) translate(-50%,-50%)';
      });
    }

    function repartir(t) {
      focoVisible = null;
      const cs = [];

      /* Primero dónde va cada uno y de qué tamaño, sin pintar: la separación
         necesita ver el conjunto antes de decidir. */
      for (const m of marcas) {
        const x = offX + (m.p.cx * t.k + t.x) * razon;
        const y = offY + (m.p.cy * t.k + t.y) * razon;

        const grande = m.p.d / 2, chico = m.p.dPunto / 2;
        let radio = chico;
        if (m.p.foto) {
          const conFoto = t.k >= m.p.kFoto;
          m.el.classList.toggle('chico', !conFoto);
          if (conFoto) radio = grande;
          else {
            /* El punto no espera quieto a su umbral: crece a medida que el zoom
               se le acerca, y casi todo ese crecimiento ocurre justo antes de
               abrirse. Eso es lo que convierte el cambio en algo anunciado en
               vez de un salto: cuando la foto aparece, el punto ya venía
               diciendo que iba a aparecer. */
            const avance = m.p.kFoto > 0 ? Math.min(1, t.k / m.p.kFoto) : 1;
            radio = chico + (grande - chico) * Math.pow(avance, 4) * .4;
          }
        }
        cs.push({ m, x, y, x0: x, y0: y, r: radio, peso: 1 + (m.p.n || 0) });
      }

      separar(cs);

      const puestos = [], circulos = [], guias = [];
      for (const c of cs) {
        const { m, x, y, r } = c;
        m.el.style.transform = 'translate(' + x + 'px,' + y + 'px) translate(-50%,-50%)';
        m.el.style.setProperty('--d', (r * 2) + 'px');
        circulos.push({ x, y, r });
        if (m.p.slug === abierta) focoVisible = { x, y, r };

        /* La guía arranca en el borde del marcador, no en su centro: cruzarlo
           por encima lo convertiría en un marcador tachado. */
        const corrio = Math.hypot(x - c.x0, y - c.y0);
        if (corrio > GUIA_DESDE) {
          const ux = (c.x0 - x) / corrio, uy = (c.y0 - y) / corrio;
          guias.push({ x1: x + ux * r, y1: y + uy * r, x2: c.x0, y2: c.y0 });
        }

        /* El nombre va 5 px por encima del borde de la lente —lo dice el CSS—,
           así que la caja de choque puede ser la real. Se mide contra los otros
           nombres y también contra los marcadores ya puestos: un nombre escrito
           encima de una foto no se lee y además tapa la foto. */
        /* Los lugares con fotografía ya no llevan nombre al lado: la miniatura
           dice qué lugar es, y al tocarla se abre la ficha con todo. El rótulo
           queda sólo donde no hay foto, que si no sería un punto anónimo. */
        if (!m.rotulo) continue;
        const w = (m.p.nombre.length * 6.6) / 2 + 6;
        const alto = r + 5;
        const caja = { a: x - w, b: x + w, c: y - alto - 15, d: y - alto };
        const choca = puestos.some(q => caja.a < q.b && caja.b > q.a && caja.c < q.d && caja.d > q.c)
          || circulos.some(q => caja.a < q.x + q.r && caja.b > q.x - q.r
                             && caja.c < q.y + q.r && caja.d > q.y - q.r);
        m.rotulo.style.display = choca ? 'none' : '';
        if (!choca) puestos.push(caja);
      }

      dibujarGuias(guias);
    }

    /* Las líneas se reusan en vez de recrearse: esto corre en cada cuadro del
       zoom, y crear nodos ahí es la forma más fácil de que el mapa se trabe. */
    const capaGuias = document.getElementById('guias');
    function dibujarGuias(guias) {
      while (capaGuias.children.length < guias.length * 2) {
        capaGuias.append(
          document.createElementNS('http://www.w3.org/2000/svg', 'line'),
          document.createElementNS('http://www.w3.org/2000/svg', 'circle'));
      }
      const hijos = capaGuias.children;
      for (let i = 0; i < hijos.length / 2; i++) {
        const g = guias[i], linea = hijos[i * 2], punto = hijos[i * 2 + 1];
        if (!g) { linea.style.display = 'none'; punto.style.display = 'none'; continue; }
        linea.style.display = ''; punto.style.display = '';
        linea.setAttribute('x1', g.x1.toFixed(1)); linea.setAttribute('y1', g.y1.toFixed(1));
        linea.setAttribute('x2', g.x2.toFixed(1)); linea.setAttribute('y2', g.y2.toFixed(1));
        /* Un punto chico donde está de verdad: sin esto la línea termina en
           ninguna parte y no se entiende qué está señalando. */
        punto.setAttribute('cx', g.x2.toFixed(1)); punto.setAttribute('cy', g.y2.toFixed(1));
        punto.setAttribute('r', '1.5');
      }
    }

    /* ---- zoom ---- */
    /* El mapa no se puede correr más allá de sí mismo: ni alejando ni
       arrastrando se llega a ver dónde se termina el dibujo. El mínimo de zoom
       es el que hace que el mapa siga cubriendo el lienzo, y se recalcula al
       cambiar el tamaño porque depende de la forma de la ventana. */
    let kMin = .8;
    function limitar() {
      const c = svgEl.getBoundingClientRect();
      /* d3 trabaja en unidades del viewBox sobre un SVG, así que el viewport
         hay que declararlo en esas unidades y no en píxeles. */
      const vw = (c.width || ANCHO) / razon, vh = (c.height || ALTO) / razon;
      kMin = Math.max(vw / ANCHO, vh / ALTO);
      /* El rectángulo que se ve NO empieza en el origen del viewBox: con las
         bandas de centrado empieza en negativo. Declarárselo a d3 arrancando
         en (0,0) le corre la restricción justo el ancho de la banda, y el mapa
         terminaba pudiéndose despegar de su borde. */
      const x0 = -padX / razon, y0 = -padY / razon;
      zm.extent([[x0, y0], [x0 + vw, y0 + vh]])
        .scaleExtent([kMin, 40])
        .translateExtent([[0, 0], [ANCHO, ALTO]]);
    }

    const zm = zoom()
      .on('zoom', ev => {
        mundo.setAttribute('transform', ev.transform.toString());
        kActual = ev.transform.k;
        tActual = ev.transform;
        repartir(ev.transform);
        dibujarPuntos(ev.transform);
        reubicarFicha();
        guardarEstado();
      });
    const sel = select(svgEl).call(zm);

    /* Doble toque para acercar, hacia donde se tocó. En el escritorio el doble
       clic ya lo hace d3; en el teléfono no se puede confiar en el `dblclick`
       sintético, porque el mapa declara `touch-action: none` y con eso iOS
       deja de emitirlo de forma predecible. */
    dobleToque(svgEl, (x, y) => {
      const c = svgEl.getBoundingClientRect();
      zm.scaleBy(sel, 2, [x - c.left, y - c.top]);
    });

    /* zoom.transform() de d3 NO pasa por scaleExtent ni translateExtent: esos
       límites sólo rigen para lo que hace el usuario. Todo encuadre que pongamos
       nosotros —el inicial, el de volver donde estabas, el de redimensionar—
       tiene que acotarse a mano o el mapa se despega de su borde. Se veía en
       pantalla vertical, donde el encuadre inicial dejaba una franja abajo. */
    function acotar(t) {
      const c = svgEl.getBoundingClientRect();
      const vw = (c.width || ANCHO) / razon, vh = (c.height || ALTO) / razon;
      const bx = -padX / razon, by = -padY / razon;
      const k = Math.min(40, Math.max(kMin, t.k));
      return zoomIdentity
        .translate(Math.min(bx, Math.max(bx + vw - ANCHO * k, t.x)),
                   Math.min(by, Math.max(by + vh - ALTO * k, t.y)))
        .scale(k);
    }
    /* Recién acá: medirTodo llama a limitar(), que configura zm. Llamarlo
       antes de crear zm rompía el módulo entero y el mapa quedaba muerto. */
    medirTodo();

    /* Todo en unidades del viewBox. El SVG escala entero al contenedor, así que
       mezclar píxeles de pantalla con unidades del mapa —que es lo que hacía la
       primera versión— da un encuadre que nunca acerca. */
    function encuadrar(slugs) {
      const ps = slugs ? PUNTOS.filter(p => slugs.includes(p.slug)) : PUNTOS;
      if (!ps.length) return;
      const xs = ps.map(p => p.cx), ys = ps.map(p => p.cy);
      const x0 = Math.min(...xs), x1 = Math.max(...xs);
      const y0 = Math.min(...ys), y1 = Math.max(...ys);
      /* Un solo punto no tiene caja: se le da una ventana de barrio. */
      const m = ps.length === 1 ? 70 : 90;
      const bw = Math.max(x1 - x0, 1) + m * 2, bh = Math.max(y1 - y0, 1) + m * 2;
      const k = Math.min(40, Math.max(kMin, Math.min(ANCHO / bw, ALTO / bh)));
      zm.transform(sel, acotar(zoomIdentity
        .translate(ANCHO / 2 - k * (x0 + x1) / 2, ALTO / 2 - k * (y0 + y1) / 2)
        .scale(k)));
    }

    /* ---- ficha del lugar ---- */
    let abierta = null;

    /* La ficha sale al lado del marcador, no en una esquina fija: lo que se
       está leyendo y el lugar del que habla tienen que estar juntos. Si no
       entra a la derecha, pasa a la izquierda; si no entra abajo, sube. */
    function reubicarFicha() {
      if (!abierta || ficha.hidden) return;
      const el = capa.querySelector('.marca-mapa[data-slug="' + abierta + '"]');
      if (!el) return;
      const c = lienzo.getBoundingClientRect(), r = el.getBoundingClientRect();
      const w = ficha.offsetWidth, h = ficha.offsetHeight, m = 16;
      let x = r.right - c.left + m;
      if (x + w > c.width - m) x = r.left - c.left - w - m;
      x = Math.max(m, Math.min(x, c.width - w - m));
      let y = r.top - c.top + r.height / 2 - 44;
      y = Math.max(m, Math.min(y, c.height - h - m));
      ficha.style.left = x + 'px';
      ficha.style.top = y + 'px';
    }

    function cerrarFicha() {
      ficha.hidden = true;
      abierta = null;
      lienzo.classList.remove('con-ficha');
      dibujarPuntos(tActual);
      guardarEstado();
      for (const m of marcas) m.el.classList.remove('foco');
    }

    function mostrar(slug) {
      const p = porSlug[slug];
      if (!p) return;
      for (const m of marcas) m.el.classList.toggle('foco', m.p.slug === slug);
      const lapso = p.desde ? (p.desde === p.hasta ? p.desde : p.desde + '–' + p.hasta) : null;
      ficha.hidden = false;
      ficha.innerHTML =
        '<div class="f-cab">' +
          '<div><strong>' + esc(p.nombre) + '</strong>' +
          '<em>' + p.n + ' ' + (p.n === 1 ? 'memoria' : 'memorias') +
          (lapso ? ' · ' + lapso : '') + '</em></div>' +
          '<button class="f-cerrar" aria-label="Cerrar">×</button>' +
        '</div>' +
        (p.notas ? '<p class="f-nota">' + esc(p.notas) + '</p>' : '') +
        '<ul class="f-memorias">' + (p.docs.map(d =>
          '<li><a href="/memorias/' + encodeURIComponent(d.slug) + '/" data-mem="' + esc(d.slug) + '">' +
          (d.foto ? '<img src="' + esc(d.foto) + '" alt="" loading="lazy" />' : '<span class="sinfoto"></span>') +
          '<span><b>' + esc(d.titulo) + '</b><i>' + esc(d.texto || d.anio || 'sin fecha') + '</i></span>' +
          '</a></li>').join('') ||
          '<li class="f-vacio">Todavía no hay memorias en este lugar.</li>') + '</ul>';
      ficha.querySelector('.f-cerrar').addEventListener('click', cerrarFicha);
      abierta = slug;
      lienzo.classList.add('con-ficha');
      dibujarPuntos(tActual);
      reubicarFicha();
      guardarEstado();
    }

    for (const m of marcas) {
      m.el.addEventListener('click', ev => {
        ev.stopPropagation();
        mostrar(m.p.slug);
        encuadrar([m.p.slug]);
      });
    }

    /* ---- la memoria, encima del mapa ---- */
    let empujado = false, lista = [], indice = 0;

    /* El recorrido es el del lugar por el que entraste. Una memoria puede estar
       ligada a más de un lugar, y entonces "la siguiente" depende de desde
       dónde la estés mirando: desde la escuela, la siguiente es la de la
       escuela. Por eso manda la ficha abierta y no el último lugar que la
       referencia. */
    function recorridoDe(slug) {
      const d = porMemoria[slug];
      const desde = (abierta && porSlug[abierta] && porSlug[abierta].docs.some(x => x.slug === slug))
        ? abierta : d.lugarSlug;
      const lugar = porSlug[desde];
      return lugar ? lugar.docs.map(x => porMemoria[x.slug]).filter(Boolean) : [d];
    }

    function abrirMemoria(slug, haciaDonde) {
      if (!porMemoria[slug]) return;
      lista = recorridoDe(slug);
      indice = Math.max(0, lista.findIndex(x => x.slug === slug));
      pintarMemoria(haciaDonde);
      velo.hidden = false;
      document.body.classList.add('con-memoria');
      /* Una sola entrada en el historial por sesión de lectura: así el botón
         atrás cierra la memoria y vuelve al mapa en vez de recorrer una por una
         todas las que se miraron. */
      const url = '/memorias/' + encodeURIComponent(slug) + '/';
      if (empujado) history.replaceState({ memoria: slug }, '', url);
      else { history.pushState({ memoria: slug }, '', url); empujado = true; }
    }

    function irA(i, haciaDonde) {
      if (i < 0 || i >= lista.length || i === indice) return;
      indice = i;
      pintarMemoria(haciaDonde);
      const url = '/memorias/' + encodeURIComponent(lista[i].slug) + '/';
      history.replaceState({ memoria: lista[i].slug }, '', url);
    }

    function pintarMemoria(haciaDonde) {
      const d = lista[indice];
      const cuando = d.texto || d.anio || 'sin fecha';
      const hay = lista.length > 1;

      /* La tira de años es el recorrido entero a la vista: se lee de dónde a
         dónde llega el material del lugar y en qué parte estás, y además se
         salta a cualquier año de un toque. */
      const tira = lista.map((m, i) =>
        '<li><button type="button" data-i="' + i + '"' +
        (i === indice ? ' class="actual" aria-current="true"' : '') + '>' +
        esc(m.anio || 's/f') + '</button></li>').join('');

      /* Las flechas van sobre la fotografía: ahí es donde está mirando el ojo
         y donde cae el pulgar. Si el lugar no tiene foto no hay dónde ponerlas
         encima, y vuelven a la fila de abajo junto a los años. */
      const flechaAnt = '<button type="button" class="t-flecha t-ant" aria-label="Memoria anterior"' +
        (indice === 0 ? ' disabled' : '') + '>‹</button>';
      const flechaSig = '<button type="button" class="t-flecha t-sig" aria-label="Memoria siguiente"' +
        (indice === lista.length - 1 ? ' disabled' : '') + '>›</button>';
      const sobreFoto = hay && !!d.foto;

      /* Dos navegaciones distintas que no se pueden confundir: las flechas
         recorren los AÑOS del lugar, los puntos recorren las FOTOS de esta
         misma memoria. Es la separación de Apple entre pasar de página y
         pasar de foto: la segunda son puntos y gesto, nunca otro par de
         flechas que compita con el primero. */
      const fotos = (d.fotos && d.fotos.length) ? d.fotos : (d.foto ? [d.foto] : []);
      const varias = fotos.length > 1;

      tarjeta.innerHTML =
        '<div class="t-cab"><div>' +
          '<h2 id="t-titulo">' + esc(d.titulo) + '</h2>' +
          '<p>' + esc(cuando) + (d.lugar ? ' · ' + esc(d.lugar) : '') +
          (hay ? ' · <span class="t-cuenta">' + (indice + 1) + ' de ' + lista.length + '</span>' : '') +
          '</p>' +
        '</div><button class="t-cerrar" aria-label="Cerrar">×</button></div>' +
        '<div class="t-vista' + (haciaDonde ? ' viene-' + haciaDonde : '') + '">' +
          (fotos.length
            ? '<div class="t-fotos">' +
                '<img class="t-foto" src="' + esc(fotos[0]) + '" alt="" />' +
                (sobreFoto ? flechaAnt + flechaSig : '') +
                (varias
                  ? '<div class="t-puntos" aria-label="Fotografías de esta memoria">' +
                    fotos.map((_, i) =>
                      '<button type="button" data-p="' + i + '"' +
                      (i === 0 ? ' class="actual"' : '') +
                      ' aria-label="Foto ' + (i + 1) + ' de ' + fotos.length + '"></button>').join('') +
                    '</div>'
                  : '') +
              '</div>'
            : '') +
          '<div class="t-cuerpo">' +
            (d.descripcion
              ? '<p>' + esc(d.descripcion) + '</p>'
              : '<p class="t-dato">Relato: <i>dato pendiente</i>.</p>') +
            (d.gente && d.gente.length
              ? '<p class="t-dato"><b>Aparecen:</b> ' + d.gente.map(esc).join(', ') + '</p>' : '') +
          '</div>' +
        '</div>' +
        (hay
          ? '<nav class="t-pasos" aria-label="Memorias de ' + esc(d.lugar || 'este lugar') + '">' +
              (sobreFoto ? '' : flechaAnt) +
              '<ol class="t-anios">' + tira + '</ol>' +
              (sobreFoto ? '' : flechaSig) +
            '</nav>'
          : '') +
        '<div class="t-pie">' +
          '<a href="/memorias/' + encodeURIComponent(d.slug) + '/">Ver la memoria completa →</a>' +
          /* El nombre del lugar ya está dos líneas más arriba, en el encabezado
             de la tarjeta: repetirlo acá hace un botón distinto en cada memoria
             y con direcciones largas queda impresentable. */
          (d.lugarSlug ? '<a href="/lugares/' + encodeURIComponent(d.lugarSlug) + '/">Más sobre este lugar</a>' : '') +
        '</div>';

      tarjeta.querySelector('.t-cerrar').addEventListener('click', cerrarMemoria);

      /* ---- las fotos de esta memoria ---- */
      if (varias) {
        const img = tarjeta.querySelector('.t-foto');
        const zona = tarjeta.querySelector('.t-fotos');
        const puntos = [...tarjeta.querySelectorAll('.t-puntos button')];
        let iFoto = 0;

        const verFoto = i => {
          if (i < 0 || i >= fotos.length || i === iFoto) return;
          iFoto = i;
          img.classList.add('cambiando');
          img.src = fotos[i];
          img.onload = () => img.classList.remove('cambiando');
          puntos.forEach((b, j) => b.classList.toggle('actual', j === i));
        };

        tarjeta.querySelector('.t-puntos').addEventListener('click', ev => {
          const b = ev.target.closest('button[data-p]');
          if (b) verFoto(+b.dataset.p);
        });

        /* Arrastrar de lado pasa de foto. El umbral evita que un clic con un
           temblor de dos píxeles cambie la imagen sin querer. */
        let x0 = null;
        zona.addEventListener('pointerdown', ev => { x0 = ev.clientX; });
        zona.addEventListener('pointercancel', () => { x0 = null; });
        zona.addEventListener('pointerup', ev => {
          if (x0 == null) return;
          const dx = ev.clientX - x0;
          x0 = null;
          if (Math.abs(dx) < 40) return;
          verFoto(iFoto + (dx < 0 ? 1 : -1));
        });
      }

      const ant = tarjeta.querySelector('.t-ant'), sig = tarjeta.querySelector('.t-sig');
      if (ant) ant.addEventListener('click', () => irA(indice - 1, 'izq'));
      if (sig) sig.addEventListener('click', () => irA(indice + 1, 'der'));
      const anios = tarjeta.querySelector('.t-anios');
      if (anios) anios.addEventListener('click', ev => {
        const b = ev.target.closest('button[data-i]');
        if (b) irA(+b.dataset.i, +b.dataset.i > indice ? 'der' : 'izq');
      });

      /* El foco sigue al control que te trajo acá: con el teclado no hay que
         volver a buscar la flecha después de cada paso. */
      const volverAlFoco = haciaDonde === 'der' ? sig : haciaDonde === 'izq' ? ant : null;
      (volverAlFoco && !volverAlFoco.disabled ? volverAlFoco : tarjeta.querySelector('.t-cerrar')).focus();
      /* El año actual tiene que quedar a la vista aunque el lugar tenga veinte. */
      const act = tarjeta.querySelector('.t-anios .actual');
      if (act) act.scrollIntoView({ block: 'nearest', inline: 'center' });
      tarjeta.scrollTop = 0;
    }

    function cerrarMemoria() {
      if (velo.hidden) return;
      velo.hidden = true;
      document.body.classList.remove('con-memoria');
      if (empujado) { empujado = false; history.back(); }
    }

    /* El enlace sigue siendo un enlace: funciona sin JS, Google lo sigue, y
       abrir en pestaña nueva con ctrl o rueda sigue llevando a la página. */
    ficha.addEventListener('click', ev => {
      const a = ev.target.closest('a[data-mem]');
      if (!a || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey) return;
      ev.preventDefault();
      abrirMemoria(a.dataset.mem);
    });

    /* Tocar en cualquier otro lado cierra la ficha: es lo que el dedo espera,
       y deja el mapa limpio sin tener que apuntarle a una cruz chica. El clic
       en un marcador no llega acá —lo detiene su propio handler—, así que
       pasar de un lugar a otro sigue funcionando de un solo toque. */
    document.addEventListener('click', ev => {
      if (ficha.hidden) return;
      if (ev.target.closest('#ficha') || ev.target.closest('.mapa-ctrl')) return;
      if (!velo.hidden) return;
      cerrarFicha();
    });

    velo.addEventListener('click', ev => { if (ev.target === velo) cerrarMemoria(); });
    window.addEventListener('popstate', () => {
      velo.hidden = true;
      document.body.classList.remove('con-memoria');
      empujado = false;
    });
    document.addEventListener('keydown', ev => {
      if (ev.key === 'Escape') {
        if (!velo.hidden) cerrarMemoria();
        else if (!ficha.hidden) cerrarFicha();
        return;
      }
      /* Con la memoria abierta, las flechas recorren el lugar en el tiempo. */
      if (velo.hidden) return;
      if (ev.key === 'ArrowRight') { ev.preventDefault(); irA(indice + 1, 'der'); }
      if (ev.key === 'ArrowLeft')  { ev.preventDefault(); irA(indice - 1, 'izq'); }
    });

    /* En iOS el touch-action no alcanza para el pellizco: hay que negarle los
       eventos de gesto propios del navegador. */
    for (const ev of ['gesturestart', 'gesturechange', 'gestureend'])
      lienzo.addEventListener(ev, e => e.preventDefault());

    /* Las curvas de la portada sólo se mueven mientras se las ve. La portada
       vive debajo del mapa y casi siempre está fuera de pantalla; dejar tres
       animaciones corriendo ahí abajo es gastar batería en algo que nadie mira.
       Sin IntersectionObserver —o si algo falla— quedan quietas, que es el
       estado bueno. El margen negativo es necesario: con 0 el observador ya
       cuenta como visible una franja que apenas toca el borde de la pantalla, y
       la portada arranca justo en el pliegue, asi que la deriva corria desde el
       primer instante sin que se viera nada. */
    const portada = document.querySelector(".portada-texto");
    if (portada && "IntersectionObserver" in window) {
      new IntersectionObserver(
        es => es.forEach(e => portada.classList.toggle("viva", e.isIntersecting)),
        { rootMargin: "-40px" }
      ).observe(portada);
    }

    /* La capa de transición arranca cuando el isotipo se va, no antes: lo que
       se percibe es una sola secuencia. */
    const transicion = document.getElementById('transicion');
    if (transicion) {
      addEventListener('carga-se-va', () => {
        transicion.classList.add('corre');
        setTimeout(() => transicion.remove(), 1600);
      }, { once: true });
      if (document.documentElement.classList.contains('sin-carga')) transicion.remove();
    }

    /* ---- bajar al resto del archivo ---- */
    const bajar = document.getElementById('bajar');
    const texto = document.querySelector('.portada-texto');
    if (bajar && texto) {
      bajar.addEventListener('click', () => {
        texto.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      /* Una vez abajo deja de señalar algo que ya estás mirando. */
      const alEstarAbajo = () => {
        const l = lienzo.getBoundingClientRect();
        bajar.classList.toggle('lejos', l.bottom < window.innerHeight * .55);
      };
      addEventListener('scroll', alEstarAbajo, { passive: true });
      alEstarAbajo();
    }

    /* ---- controles ---- */
    document.getElementById('acercar').addEventListener('click', () => zm.scaleBy(sel, 1.6));
    document.getElementById('alejar').addEventListener('click', () => zm.scaleBy(sel, 1 / 1.6));
    document.getElementById('todo').addEventListener('click', () => { cerrarFicha(); encuadrar(); });

    /* Si venís de adentro del sitio, el mapa te devuelve donde estabas. Si es
       la primera vez, arranca mostrando dónde está el material y no el ejido
       entero vacío. */
    const vuelta = estadoGuardado();
    if (vuelta && isFinite(vuelta.k)) {
      zm.transform(sel, acotar(zoomIdentity.translate(vuelta.x, vuelta.y).scale(vuelta.k)));
      if (vuelta.abierta && porSlug[vuelta.abierta]) mostrar(vuelta.abierta);
    } else {
      encuadrar(PUNTOS.filter(p => p.n > 0).map(p => p.slug));
    }

    /* Redimensionar no vuelve a encuadrar: la ventana que cambia de tamaño no
       es motivo para perder el lugar donde estabas mirando. */
    new ResizeObserver(() => {
      medirTodo();
      /* El mínimo de zoom pudo cambiar con la forma de la ventana: si la
         transformación actual quedó por debajo, d3 la corrige al reaplicarla. */
      zm.transform(sel, acotar(tActual));
      repartir(tActual);
      reubicarFicha();
    }).observe(svgEl);
  </script>

  <style is:global>
    /* ================================================================
       EL MAPA
       La base cartográfica es contexto y va recesiva: el pueblo dibujado
       en papel. Las memorias son el dato y son lo único con peso.
       Los colores de los .svg vienen del modo oscuro en que se generaron;
       se repintan acá por CSS, que gana a los atributos de presentación.
