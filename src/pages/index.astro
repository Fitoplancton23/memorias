    .f-memorias .sinfoto { width: 54px; height: 40px; border-radius: 2px; flex: none;
                           border: 1px dashed var(--linea-viva); }
    .f-memorias b { display: block; font-weight: 400; font-size: .8rem; line-height: 1.3; }
    .f-memorias i { font-style: normal; font-size: .7rem; color: var(--tinta-2); }
    .f-vacio { font-size: .78rem; color: var(--tinta-2); padding: .8rem .6rem; }

    /* --- la memoria abierta sobre el mapa ---
