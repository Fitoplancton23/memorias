    .mapa-ficha .f-cab { display: flex; gap: .7rem; align-items: flex-start; padding: .95rem 1.05rem;
                         border-bottom: 1px solid var(--linea); }
    .mapa-ficha strong { display: block; font-weight: 500; font-size: .95rem; }
