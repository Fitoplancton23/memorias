                            font-size: 1.15rem; line-height: 1; color: var(--tinta-2); }
    .mapa-ficha .f-cerrar:hover { color: var(--cursor); }
    .mapa-ficha .f-nota { margin: .7rem 1.05rem 0; font-size: .76rem; color: var(--tinta-2); }
    .f-memorias { list-style: none; margin: 0; padding: .4rem; }
