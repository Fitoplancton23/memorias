       transparencias en capas y mucho espacio negativo.
       El resplandor es jerarquía: marca dónde estás mirando. No se
       reparte por decoración.
       ================================================================ */

    .red-lienzo { position: absolute; inset: 0; overflow: hidden; }
    #red { display: block; width: 100%; height: 100%; cursor: grab; touch-action: none; }
    #red:active { cursor: grabbing; }

    /* vidrio: una sola definición para todos los paneles */
    .leyenda, .red-ficha, .buscador, .buscador ul, .mini svg, .mini-ctrl button {
      background: rgba(255, 255, 255, .72);
      -webkit-backdrop-filter: blur(20px) saturate(1.15);
      backdrop-filter: blur(20px) saturate(1.15);
      border: 1px solid var(--linea);
      box-shadow: 0 12px 34px -20px rgba(24, 30, 27, .34);
    }

    /* Nada se saca del DOM al cambiar el foco: se funde, para que la
       transición sea un solo movimiento y no un parpadeo. */
    .oculto { opacity: 0 !important; pointer-events: none; }
    #nodos g, #borde g, #linajes g, #sitios g, #resplandores circle,
    .halo, .rot-fam, .barra, .peine { transition: opacity .42s ease; }

    /* --- PLANO 1 · la familia enfocada ------------------------------ */
    .halo { opacity: .2; }
    .rot-fam { font: 500 11px var(--texto); letter-spacing: .18em; text-transform: uppercase;
               fill: var(--tinta-2); text-anchor: end; }
    .barra { fill: none; stroke: var(--vinculo); stroke-width: 2; }
    .peine { fill: none; stroke: var(--vinculo); stroke-width: 1.1; stroke-dasharray: 3 4; opacity: .7; }

    .glow { fill: var(--tipo-persona); opacity: .3; }
