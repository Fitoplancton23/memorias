    .f-ficha { display: block; padding: .65rem 1.05rem; border: 0; border-top: 1px solid var(--linea);
               font-size: .66rem; letter-spacing: .09em; text-transform: uppercase; color: var(--tinta-2); }
    .f-ficha:hover { color: var(--cursor); }

    /* --- PORTADA · el paso previo ----------------------------------- */
    .portada { position: absolute; inset: 0; z-index: 5; display: grid; place-items: center;
               padding: 1.5rem; background: rgba(237, 249, 244, .58);
               -webkit-backdrop-filter: blur(28px) saturate(1.08);
               backdrop-filter: blur(28px) saturate(1.08);
               animation: entra .5s ease both; }
    .portada.yendose { animation: sale .42s ease both; }
    @keyframes entra { from { opacity: 0; } to { opacity: 1; } }
    @keyframes sale  { to { opacity: 0; -webkit-backdrop-filter: blur(0); backdrop-filter: blur(0); } }

    .portada-caja { width: min(34rem, 100%); max-height: 100%; overflow-y: auto; text-align: center;
                    background: rgba(255, 255, 255, .88); border: 1px solid var(--linea);
                    border-radius: 6px;
                    box-shadow: 0 34px 80px -46px rgba(24, 30, 27, .55);
                    padding: 2.6rem 2.1rem 1.7rem; }
    .portada-sello { width: 38px; height: 38px; color: var(--linea-viva); }
    .portada-caja h2 { font-weight: 500; font-size: 1.5rem; letter-spacing: .26em;
                       text-transform: uppercase; margin: .7rem 0 .35rem; color: var(--tinta); }
