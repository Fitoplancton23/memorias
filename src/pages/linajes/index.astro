    /* --- minimapa --------------------------------------------------- */
    .mini { position: absolute; right: 1.9rem; bottom: 1.6rem; display: flex; gap: .5rem;
            align-items: flex-end; }
    .mini svg { display: block; width: 200px; height: 130px; border-radius: 4px; }
    .mp { fill: var(--linea-viva); }
    .mp.linaje { fill: var(--halo-familia); opacity: .8; }
